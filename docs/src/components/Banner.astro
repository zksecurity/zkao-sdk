---
// Staging builds (PUBLIC_DOCS_CHANNEL=staging) carry a notice on every page.
const staging = import.meta.env.PUBLIC_DOCS_CHANNEL === "staging";
const { banner } = Astro.locals.starlightRoute.entry.data;
const content = staging
  ? 'These docs describe <a href="https://staging.zkao.io">staging.zkao.io</a> and the <code>@zksecurity/zkao-cli@next</code> release. For production, see <a href="https://docs.zkao.io">docs.zkao.io</a>.'
  : banner?.content;
---

{content && <div class="sl-banner" data-pagefind-ignore set:html={content} />}

<style>
  .sl-banner {
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    line-height: var(--sl-line-height-headings);
    text-align: center;
    text-wrap: balance;
    font-size: var(--sl-text-sm);
  }
  .sl-banner :global(a) {
    color: var(--sl-color-white);
  }
</style>
